+    private void enforceSessionHandleOwner(SessionHandle handle) {
+        Objects.requireNonNull(handle, "SessionHandle cannot be null");
+        if (handle.getUid() != Binder.getCallingUid()
+                || handle.getPid() != Binder.getCallingPid()) {
+            throw new SecurityException("SessionHandle does not belong to the caller");
+        }
+    }
+
+    private void enforceSessionHandleOwner(SessionHandle handle, AttributionSource source) {
+        Objects.requireNonNull(source, "AttributionSource cannot be null");
+        enforceSessionHandleOwner(handle);
+        if (source.getUid() != Binder.getCallingUid()
+                || !Objects.equals(handle.getPackageName(), source.getPackageName())) {
+            throw new SecurityException("SessionHandle does not match the caller attribution");
+        }
+    }
+
+    private void enforceOobHandleOwner(OobHandle handle) {
+        Objects.requireNonNull(handle, "OobHandle cannot be null");
