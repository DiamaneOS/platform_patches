@@ -54,6 +54,16 @@ struct oapv_bs {
 #if ENABLE_ENCODER
 ///////////////////////////////////////////////////////////////////////////////
 
+/* The encoder reserves the otherwise unused ndata[0] for a sticky writer error. */
+#define BSW_ERROR(bs) ((bs)->ndata[0])
+
+static inline bool bsw_has_space(oapv_bs_t *bs, size_t bytes)
+{
+    uintptr_t cur = (uintptr_t)bs->cur;
+    uintptr_t end = (uintptr_t)bs->end;
+    return cur >= (uintptr_t)bs->beg && cur <= end && bytes <= end - cur;
+}
+
 /* move current write position to a specific bitstream address */
 #define BSW_MOVE_CUR(bs, addr) \
     (bs)->cur = addr; \
