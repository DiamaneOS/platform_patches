+          uint32_t CONTEXT = val_current;
+          CONTEXT |= pImage->GetPixel(w + GBAT[0], row_gbat) << 3;
+          CONTEXT |= val_prev1 << 4;
+          CONTEXT |= val_prev2 << 9;
