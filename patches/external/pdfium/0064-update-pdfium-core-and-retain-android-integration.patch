-  }
-  if (FontStyleIsItalic(style)) {
-    font += "Italic";
-  }
-  if (FontStyleIsSerif(style)) {
-    font += "Serif";
-  }
-  font += static_cast<uint8_t>(charset);
-  return FX_HashCode_GetA(font.AsStringView());
-}
