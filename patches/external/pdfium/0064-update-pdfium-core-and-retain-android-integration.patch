+int FXSYS_TimeZoneOffsetInMinutes(const tm& local_time, const tm& utc_time) {
+  int day_offset = local_time.tm_mday - utc_time.tm_mday;
+  if (day_offset > 1) {
+    day_offset = -1;
+  } else if (day_offset < -1) {
+    day_offset = 1;
