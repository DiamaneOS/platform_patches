     case FXCODEC_IMAGE_PNG:
       return PngContinueDecode();
-#endif  // PDF_ENABLE_XFA_PNG
-#ifdef PDF_ENABLE_XFA_TIFF
     case FXCODEC_IMAGE_TIFF:
       return TiffContinueDecode();
-#endif  // PDF_ENABLE_XFA_TIFF
     default:
       return FXCODEC_STATUS::kError;
