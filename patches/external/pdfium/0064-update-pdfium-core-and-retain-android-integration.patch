+bool PruneFieldArray(
+    CPDF_Array* fields,
+    const std::set<RetainPtr<const CPDF_Dictionary>>& widget_annots,
+    std::set<RetainPtr<CPDF_Dictionary>>& visited_fields,
+    int level) {
+  if (level > kMaxRecursion) {
+    return fields->IsEmpty();
+  }
+
+  for (size_t i = fields->size(); i > 0; --i) {
+    const size_t field_index = i - 1;
+    RetainPtr<CPDF_Dictionary> field = fields->GetMutableDictAt(field_index);
+    if (!field) {
+      continue;
+    }
