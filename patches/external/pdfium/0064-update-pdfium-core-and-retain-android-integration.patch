+StringViewType ParseLeadingChars(StringViewType str) {
+  // Skip leading whitespaces, plus signs, and minus signs.
+  size_t start = 0;
+  size_t len = str.GetLength();
+  while (start < len &&
+         (str[start] == ' ' || str[start] == '+' || str[start] == '-')) {
+    ++start;
