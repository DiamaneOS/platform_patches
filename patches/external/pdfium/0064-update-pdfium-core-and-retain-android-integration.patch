+
+  title = GetFPDFWideString(L"Style Is Not An Int");
+  bookmark = FPDFBookmark_Find(document(), title.get());
+  ASSERT_TRUE(bookmark);
+  EXPECT_EQ(0, FPDFBookmark_GetStyle(bookmark));
+
+  title = GetFPDFWideString(L"Style Is 15");
+  bookmark = FPDFBookmark_Find(document(), title.get());
+  ASSERT_TRUE(bookmark);
