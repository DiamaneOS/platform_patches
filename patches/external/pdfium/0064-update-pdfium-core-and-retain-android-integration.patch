-uint32_t SkiaNormalizeFontName(ByteStringView family) {
-  uint32_t hash_code = 0;
-  for (unsigned char ch : family) {
-    if (ch == ' ' || ch == '-' || ch == ',') {
-      continue;
-    }
-    hash_code = 31 * hash_code + tolower(ch);
-  }
-  return hash_code;
-}
