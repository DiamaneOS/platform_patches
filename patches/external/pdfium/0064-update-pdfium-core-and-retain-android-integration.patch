+LibjpegJpegContext::LibjpegJpegContext(
+    ProgressiveDecoderContextDelegate* delegate)
+    : delegate_(delegate) {
+  common_.cinfo.client_data = &common_;
+  common_.cinfo.err = &common_.error_mgr;
