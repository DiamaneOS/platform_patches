-void AddCharcode(fxcrt::ostringstream& buffer, uint32_t number) {
-  CHECK_LE(number, 0xFFFF);
-  buffer << "<";
-  char ans[4];
-  FXSYS_IntToFourHexChars(number, ans);
-  for (char c : ans) {
-    buffer << c;
-  }
-  buffer << ">";
-}
