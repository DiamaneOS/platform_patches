+  if (color->red > 1 || color->green > 1 || color->blue > 1) {
+    return false;
+  }
+  if (color->red < 0 || color->green < 0 || color->blue < 0) {
+    return false;
+  }
+  *R = color->red;
+  *G = color->green;
+  *B = color->blue;
+  return true;
