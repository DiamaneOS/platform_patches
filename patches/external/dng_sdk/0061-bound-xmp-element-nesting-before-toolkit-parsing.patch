index 0000000000000000000000000000000000000000..d94d9723f99d154718673ad00ba5595762c54c5b
--- /dev/null
+++ b/source/dng_xmp_limits.h
@@ -0,0 +1,85 @@
+// Copyright (C) 2026 The DiamaneOS Project
+// SPDX-License-Identifier: Apache-2.0
+#ifndef DNG_XMP_LIMITS_H
+#define DNG_XMP_LIMITS_H
+
+#include "dng_exceptions.h"
+#include "dng_types.h"
+#include <cstddef>
+#include <cstring>
+
+// Resource preflight only; XML syntax is still checked by the XMP toolkit.
+static void CheckXmpTreeLimit(const char* data, uint32 byteCount)
+    {
+    if (data == nullptr || byteCount == 0) return;
+    const auto* bytes = reinterpret_cast<const unsigned char*>(data);
+    size_t width = 1;
+    bool little = false;
+    // Match the toolkit's DetermineInputEncoding decision, including short inputs.
+    if (byteCount >= 2)
+        {
+        if (bytes[0] == 0)
+            width = byteCount >= 4 && bytes[1] == 0 ? 4 : 2;
+        else if (bytes[0] < 0x80)
+            {
+            if (bytes[1] == 0)
+                { width = byteCount >= 4 && bytes[2] == 0 ? 4 : 2; little = true; }
+            }
+        else if (bytes[0] != 0xef)
+            {
+            little = bytes[0] != 0xfe;
+            width = little && byteCount >= 4 && bytes[2] == 0 ? 4 : 2;
+            }
+        }
+    const size_t count = byteCount / width;
+    auto ascii = [&](size_t at) -> int
+        {
+        if (at >= count) return -1;
+        uint32 code = 0;
+        for (size_t k = 0; k < width; ++k)
+            code = (code << 8) | bytes[at * width + (little ? width - k - 1 : k)];
+        return code < 128 ? static_cast<int>(code) : 256;
+        };
+    auto matches = [&](size_t at, const char* token) -> bool
+        {
+        const size_t size = std::strlen(token);
+        if (at > count || size > count - at) return false;
+        for (size_t k = 0; k < size; ++k)
+            if (ascii(at + k) != token[k]) return false;
+        return true;
+        };
+    auto after = [&](size_t at, const char* terminator) -> size_t
+        {
+        while (at < count && !matches(at, terminator)) ++at;
+        return at == count ? count : at + std::strlen(terminator);
+        };
+    uint32 depth = 0;
+    for (size_t at = 0; at < count;)
+        {
+        if (ascii(at) != '<') { ++at; continue; }
+        if (matches(at, "<!--")) { at = after(at + 4, "-->"); continue; }
+        if (matches(at, "<![CDATA[")) { at = after(at + 9, "]]>"); continue; }
+        if (matches(at, "<?")) { at = after(at + 2, "?>"); continue; }
+        if (matches(at, "<!")) ThrowBadFormat("XMP declarations are not permitted");
+        if (matches(at, "</"))
+            {
+            if (depth != 0) --depth;
+            at = after(at + 2, ">");
+            continue;
+            }
+        if (depth >= 64) ThrowBadFormat("XMP element nesting exceeds limit");
+        int quote = 0;
+        size_t end = at + 1;
+        for (; end < count; ++end)
+            {
+            const int c = ascii(end);
+            if (quote != 0) { if (c == quote) quote = 0; }
+            else if (c == '\'' || c == '"') quote = c;
+            else if (c == '>') break;
+            }
+        // XML permits no whitespace between the slash and closing bracket.
+        if (end == at + 1 || ascii(end - 1) != '/') ++depth;
+        at = end == count ? count : end + 1;
+        }
+    }
+#endif
